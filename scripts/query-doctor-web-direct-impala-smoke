#!/usr/bin/env python3
"""Smoke-check direct-Impala Recent metadata through the local web wrapper."""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from collections import Counter
from dataclasses import dataclass
from pathlib import Path
from typing import Any
from urllib.parse import urlencode, urlsplit


ROOT_DIR = Path(__file__).resolve().parents[1]
DEFAULT_WEB_WRAPPER = ROOT_DIR / "scripts" / "query-doctor-web-local"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_WINDOW_MINUTES = 120
DEFAULT_TRIAGE_LIMIT = 3
DEFAULT_METADATA_TOP_LIMIT = 1
DEFAULT_PARALLELISM = 2
DEFAULT_METADATA_JOBS = 1
DEFAULT_TIMEOUT_SEC = 180.0
DEFAULT_POLL_INTERVAL_SEC = 0.5
JOB_ID_RE = re.compile(r"^[0-9a-f]{32}$")
FORBIDDEN_DETAILS_MARKERS = {
    "local_tmp_path": "/tmp/",
    "case_dir": "case_dir",
    "subprocess_output": "subprocess output",
}


class SmokeError(Exception):
    pass


@dataclass(frozen=True)
class HttpResponse:
    status: int
    headers: dict[str, str]
    body: str


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be an integer") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return parsed


def non_negative_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be an integer") from exc
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be non-negative")
    return parsed


def positive_float(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a number") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return parsed


def non_negative_float(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a number") from exc
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be non-negative")
    return parsed


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run a bounded local-web direct Impala Recent smoke. The script "
            "starts scripts/query-doctor-web-local, submits the normal web "
            "Finished-query form, and checks only aggregate raw-free statuses."
        )
    )
    parser.add_argument(
        "--config",
        type=Path,
        help=(
            "Local Query Doctor config. Defaults to $QD_CONFIG, then "
            "~/.qdcreds/query-doctor-config.json."
        ),
    )
    parser.add_argument(
        "--cluster",
        "--config-cluster",
        dest="cluster",
        help=(
            "Cluster id from config clusters[]. Required only when multiple "
            "direct-Impala clusters exist."
        ),
    )
    parser.add_argument(
        "--web-wrapper",
        type=Path,
        default=DEFAULT_WEB_WRAPPER,
        help="Local web wrapper to start. Default: scripts/query-doctor-web-local.",
    )
    parser.add_argument(
        "--host", default=DEFAULT_HOST, help="Local bind host. Default: %(default)s"
    )
    parser.add_argument(
        "--port",
        type=positive_int,
        help="Local bind port. Defaults to a free ephemeral localhost port.",
    )
    parser.add_argument(
        "--window-minutes",
        type=positive_int,
        default=int(
            os.environ.get("QD_WEB_DIRECT_IMPALA_SMOKE_WINDOW_MINUTES", DEFAULT_WINDOW_MINUTES)
        ),
        help="Finished-query Search depth in minutes. Default: %(default)s",
    )
    parser.add_argument(
        "--limit",
        type=positive_int,
        default=int(os.environ.get("QD_WEB_DIRECT_IMPALA_SMOKE_LIMIT", DEFAULT_TRIAGE_LIMIT)),
        help="Maximum profiles to collect/analyze through the web form. Default: %(default)s",
    )
    parser.add_argument(
        "--metadata-top-limit",
        type=non_negative_int,
        default=int(
            os.environ.get(
                "QD_WEB_DIRECT_IMPALA_SMOKE_METADATA_TOP_LIMIT",
                DEFAULT_METADATA_TOP_LIMIT,
            )
        ),
        help="Maximum selected cases to refresh metadata for. Default: %(default)s",
    )
    parser.add_argument(
        "--metadata-jobs",
        type=positive_int,
        default=int(
            os.environ.get("QD_WEB_DIRECT_IMPALA_SMOKE_METADATA_JOBS", DEFAULT_METADATA_JOBS)
        ),
        help="Metadata parallelism passed through the web form. Default: %(default)s",
    )
    parser.add_argument(
        "--parallelism",
        type=positive_int,
        default=int(os.environ.get("QD_WEB_DIRECT_IMPALA_SMOKE_PARALLELISM", DEFAULT_PARALLELISM)),
        help="Recent scan parallelism passed through the web form. Default: %(default)s",
    )
    parser.add_argument(
        "--query-type",
        default=os.environ.get("QD_WEB_DIRECT_IMPALA_SMOKE_QUERY_TYPE", "QUERY"),
        help="Optional query type filter. Default: %(default)s",
    )
    parser.add_argument(
        "--all-query-types",
        action="store_true",
        help="Do not submit a query type filter.",
    )
    parser.add_argument(
        "--min-duration-sec",
        type=non_negative_float,
        help="Optional minimum duration filter submitted through the web form.",
    )
    parser.add_argument(
        "--allow-no-metadata",
        action="store_true",
        help="Do not fail when the scan succeeds but no metadata context is collected.",
    )
    parser.add_argument(
        "--skip-details-check",
        action="store_true",
        help="Skip the selected Details page safety check.",
    )
    parser.add_argument(
        "--timeout-sec",
        type=positive_float,
        default=DEFAULT_TIMEOUT_SEC,
        help="Overall startup/job timeout in seconds. Default: %(default)s",
    )
    parser.add_argument(
        "--poll-interval-sec",
        type=positive_float,
        default=DEFAULT_POLL_INTERVAL_SEC,
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate config selection and print a raw-free run summary without starting web.",
    )
    return parser.parse_args(argv)


def default_config_path() -> Path:
    if os.environ.get("QD_CONFIG"):
        return Path(os.environ["QD_CONFIG"])
    creds_dir = Path(os.environ.get("QD_CREDS_DIR", str(Path.home() / ".qdcreds")))
    for candidate in (
        creds_dir / "query-doctor-config.json",
        ROOT_DIR / "query-doctor-config.json",
        ROOT_DIR / ".query-doctor-cm.local.json",
    ):
        if candidate.is_file():
            return candidate
    return creds_dir / "query-doctor-config.json"


def load_json_config(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SmokeError("Config file was not found. Set --config or QD_CONFIG.") from exc
    except json.JSONDecodeError as exc:
        raise SmokeError("Config file is not valid JSON.") from exc
    if not isinstance(payload, dict):
        raise SmokeError("Config root must be a JSON object.")
    return payload


def is_direct_impala_config(values: dict[str, Any]) -> bool:
    source = str(values.get("query_profile_source") or values.get("cluster_type") or "").strip()
    if source:
        return source.lower() == "impala"
    hosts = values.get("impala_profile_hosts")
    return isinstance(hosts, list) and bool(hosts)


def safe_cluster_label(cluster: dict[str, Any]) -> str:
    cluster_id = str(cluster.get("id") or "<missing-id>").strip() or "<missing-id>"
    label = str(cluster.get("label") or "").strip()
    return f"{cluster_id} ({label})" if label else cluster_id


def select_cluster_id(config: dict[str, Any], requested: str | None) -> str | None:
    clusters = [cluster for cluster in config.get("clusters") or [] if isinstance(cluster, dict)]
    direct_clusters = [cluster for cluster in clusters if is_direct_impala_config(cluster)]
    if requested:
        matching = [cluster for cluster in clusters if str(cluster.get("id") or "") == requested]
        if not matching:
            available = (
                ", ".join(safe_cluster_label(cluster) for cluster in direct_clusters) or "none"
            )
            raise SmokeError(
                f"Cluster id {requested!r} was not found. Direct-Impala clusters: {available}."
            )
        if not is_direct_impala_config(matching[0]):
            raise SmokeError(f"Cluster id {requested!r} is not configured as direct Impala.")
        return requested
    if direct_clusters:
        if len(direct_clusters) == 1:
            selected = str(direct_clusters[0].get("id") or "").strip()
            if not selected:
                raise SmokeError("The only direct-Impala cluster is missing an id.")
            return selected
        available = "\n".join(f"  - {safe_cluster_label(cluster)}" for cluster in direct_clusters)
        raise SmokeError(
            "Multiple direct-Impala clusters are configured; choose one with --cluster:\n"
            + available
        )
    if is_direct_impala_config(config):
        return None
    raise SmokeError(
        "No direct-Impala cluster found in config. Add a clusters[] entry with "
        'query_profile_source "impala" and impala_profile_hosts.'
    )


def free_local_port(host: str) -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind((host, 0))
        return int(sock.getsockname()[1])


def request(
    host: str,
    port: int,
    method: str,
    path: str,
    *,
    body: bytes | None = None,
    headers: dict[str, str] | None = None,
    timeout_sec: float = 5.0,
) -> HttpResponse:
    connection = http.client.HTTPConnection(host, port, timeout=timeout_sec)
    try:
        connection.request(method, path, body=body, headers=headers or {})
        response = connection.getresponse()
        text = response.read().decode("utf-8", errors="replace")
        return HttpResponse(
            status=response.status,
            headers={name.lower(): value for name, value in response.getheaders()},
            body=text,
        )
    finally:
        connection.close()


def start_web(
    args: argparse.Namespace,
    *,
    config_path: Path,
    port: int,
) -> subprocess.Popen[str]:
    wrapper = args.web_wrapper.expanduser()
    if not wrapper.is_file():
        raise SmokeError("Local web wrapper was not found.")
    env = dict(os.environ)
    env["QD_CONFIG"] = str(config_path)
    command = [
        str(wrapper),
        "--host",
        args.host,
        "--port",
        str(port),
        "--no-llm",
    ]
    return subprocess.Popen(
        command,
        cwd=ROOT_DIR,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        start_new_session=os.name == "posix",
    )


def stop_web(process: subprocess.Popen[str] | None) -> None:
    if process is None or process.poll() is not None:
        return
    try:
        if os.name == "posix":
            os.killpg(process.pid, signal.SIGTERM)
        else:
            process.terminate()
        process.wait(timeout=5)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        if process.poll() is None:
            if os.name == "posix":
                os.killpg(process.pid, signal.SIGKILL)
            else:
                process.kill()
            process.wait(timeout=5)


def wait_for_web_ready(
    process: subprocess.Popen[str],
    *,
    host: str,
    port: int,
    deadline: float,
    poll_interval_sec: float,
) -> None:
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise SmokeError(
                "Local web server exited before becoming ready. Check local credentials, "
                "Kerberos, config, and port settings."
            )
        try:
            response = request(host, port, "GET", "/", timeout_sec=2.0)
        except OSError:
            time.sleep(poll_interval_sec)
            continue
        if response.status == 200:
            return
        time.sleep(poll_interval_sec)
    raise SmokeError(
        "Local web server did not become ready before timeout. Check local credentials, "
        "Kerberos, config, and port settings."
    )


def form_value(value: object) -> str:
    return "" if value is None else str(value)


def scan_form(args: argparse.Namespace, cluster_id: str | None) -> dict[str, str]:
    form = {
        "cluster_key": cluster_id or "",
        "scan_target": "finished",
        "recent_window_minutes": str(args.window_minutes),
        "triage_profile_limit": str(args.limit),
        "metadata_top_limit": str(args.metadata_top_limit),
        "metadata_jobs": str(args.metadata_jobs),
        "parallelism": str(args.parallelism),
        "min_duration_sec": form_value(args.min_duration_sec),
    }
    if not args.all_query_types and str(args.query_type or "").strip():
        form["query_type"] = str(args.query_type).strip().upper()
    return form


def start_scan(
    args: argparse.Namespace,
    *,
    cluster_id: str | None,
    port: int,
) -> str:
    payload = urlencode(scan_form(args, cluster_id)).encode("utf-8")
    response = request(
        args.host,
        port,
        "POST",
        "/batch/run",
        body=payload,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Content-Length": str(len(payload)),
        },
    )
    if response.status != 303:
        raise SmokeError(
            "Web scan did not start. Check selected cluster settings, metadata setup, "
            "Kerberos ticket, and filters."
        )
    location = response.headers.get("location", "")
    path = urlsplit(location).path
    prefix = "/jobs/"
    if not path.startswith(prefix):
        raise SmokeError("Web scan returned an unexpected job redirect.")
    job_id = path[len(prefix) :]
    if not JOB_ID_RE.fullmatch(job_id):
        raise SmokeError("Web scan returned an invalid job id.")
    return job_id


def safe_error_snippet(value: object) -> str:
    text = " ".join(str(value or "").split())
    if not text:
        return ""
    unsafe_markers = ("/tmp/", "FILE:", "http://", "https://", "case_dir", "\\")
    if any(marker in text for marker in unsafe_markers):
        return ""
    return text[:240]


def poll_job(
    args: argparse.Namespace,
    *,
    job_id: str,
    port: int,
    deadline: float,
) -> dict[str, Any]:
    status_path = f"/jobs/{job_id}/status"
    while time.monotonic() < deadline:
        response = request(args.host, port, "GET", status_path, timeout_sec=5.0)
        if response.status != 200:
            raise SmokeError("Web job status endpoint returned an unexpected status.")
        try:
            payload = json.loads(response.body)
        except json.JSONDecodeError as exc:
            raise SmokeError("Web job status endpoint returned invalid JSON.") from exc
        if not isinstance(payload, dict):
            raise SmokeError("Web job status payload is invalid.")
        status = str(payload.get("status") or "")
        if status == "ok":
            return payload
        if status in {"failed", "cancelled"}:
            detail = safe_error_snippet(payload.get("error"))
            suffix = f" Safe error: {detail}" if detail else ""
            raise SmokeError(f"Web Recent scan failed or was cancelled.{suffix}")
        time.sleep(args.poll_interval_sec)
    raise SmokeError("Web Recent scan did not finish before timeout.")


def batch_summary_path(job_id: str) -> Path:
    return Path("/tmp") / f"query-doctor-web-batch-{job_id}" / "batch_summary.json"


def load_batch_summary(job_id: str) -> dict[str, Any]:
    path = batch_summary_path(job_id)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SmokeError("Web scan completed but batch summary was not created.") from exc
    except json.JSONDecodeError as exc:
        raise SmokeError("Web scan batch summary is not valid JSON.") from exc
    if not isinstance(payload, dict):
        raise SmokeError("Web scan batch summary root is invalid.")
    return payload


def int_value(value: object) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def summary_cases(summary: dict[str, Any]) -> list[dict[str, Any]]:
    cases = summary.get("cases")
    if not isinstance(cases, list):
        return []
    return [case for case in cases if isinstance(case, dict)]


def case_has_metadata(case: dict[str, Any]) -> bool:
    return str(case.get("metadata_status") or "") == "collected" or (
        int_value(case.get("collected_metadata_table_count")) > 0
    )


def validate_summary(
    args: argparse.Namespace,
    summary: dict[str, Any],
) -> tuple[list[dict[str, Any]], dict[str, int]]:
    cases = summary_cases(summary)
    if not cases:
        raise SmokeError(
            "Web scan completed but selected no cases. Widen filters or run a test query."
        )
    collection_counts = Counter(str(case.get("collection_status") or "unknown") for case in cases)
    analysis_counts = Counter(str(case.get("analysis_status") or "unknown") for case in cases)
    if collection_counts != {"ok": len(cases)}:
        raise SmokeError("At least one selected case failed profile collection.")
    if analysis_counts != {"ok": len(cases)}:
        raise SmokeError("At least one selected case failed deterministic analysis.")
    metadata_collected = sum(1 for case in cases if case_has_metadata(case))
    metadata_refreshed = sum(1 for case in cases if case.get("metadata_refreshed") is True)
    if args.metadata_top_limit > 0 and not args.allow_no_metadata and metadata_collected < 1:
        raise SmokeError(
            "Web scan completed but collected no metadata contexts. Use a table-backed "
            "recent query, widen filters, or pass --allow-no-metadata for discovery-only smoke."
        )
    selected_count = int_value(summary.get("selected_count"))
    metrics = {
        "selected": selected_count or len(cases),
        "cases": len(cases),
        "metadata_collected": metadata_collected,
        "metadata_refreshed": metadata_refreshed,
        "collection_ok": collection_counts.get("ok", 0),
        "analysis_ok": analysis_counts.get("ok", 0),
    }
    return cases, metrics


def case_id_from_summary_case(case: dict[str, Any]) -> str | None:
    parsed = int_value(case.get("case_index"))
    if parsed <= 0:
        return None
    return f"case-{parsed:03d}"


def check_details_page(
    args: argparse.Namespace,
    *,
    cases: list[dict[str, Any]],
    port: int,
) -> None:
    metadata_cases = [case for case in cases if case_has_metadata(case)]
    selected_case = metadata_cases[0] if metadata_cases else cases[0]
    case_id = case_id_from_summary_case(selected_case)
    if case_id is None:
        raise SmokeError("Cannot derive safe Details case id from summary.")
    response = request(args.host, port, "GET", f"/batch/case/{case_id}", timeout_sec=10.0)
    if response.status != 200:
        raise SmokeError("Details page returned an unexpected status.")
    body = response.body
    lower_body = body.lower()
    leaked = [
        name for name, marker in FORBIDDEN_DETAILS_MARKERS.items() if marker.lower() in lower_body
    ]
    if leaked:
        raise SmokeError("Details page exposed forbidden browser marker(s): " + ", ".join(leaked))
    if metadata_cases and ("metadata" not in lower_body or "collected" not in lower_body):
        raise SmokeError("Details page did not show the collected metadata state.")


def print_dry_run(args: argparse.Namespace, *, cluster_id: str | None) -> None:
    print("[web-direct-impala-smoke] dry_run=ok")
    print(
        "[web-direct-impala-smoke] cluster="
        + (
            "top-level direct Impala config"
            if cluster_id is None
            else "selected direct-Impala cluster"
        )
    )
    print(
        "[web-direct-impala-smoke] scan=finished "
        f"window_minutes={args.window_minutes} limit={args.limit} "
        f"metadata_top_limit={args.metadata_top_limit} "
        f"query_type={'all' if args.all_query_types else str(args.query_type or '').strip().upper()}"
    )


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    config_path = (args.config or default_config_path()).expanduser()
    process: subprocess.Popen[str] | None = None
    try:
        config = load_json_config(config_path)
        cluster_id = select_cluster_id(config, args.cluster)
        if args.dry_run:
            print_dry_run(args, cluster_id=cluster_id)
            return 0
        port = args.port or free_local_port(args.host)
        deadline = time.monotonic() + args.timeout_sec
        process = start_web(args, config_path=config_path, port=port)
        wait_for_web_ready(
            process,
            host=args.host,
            port=port,
            deadline=deadline,
            poll_interval_sec=args.poll_interval_sec,
        )
        print("[web-direct-impala-smoke] web=ready", flush=True)
        job_id = start_scan(args, cluster_id=cluster_id, port=port)
        poll_job(args, job_id=job_id, port=port, deadline=deadline)
        summary = load_batch_summary(job_id)
        cases, metrics = validate_summary(args, summary)
        print(
            "[web-direct-impala-smoke] scan="
            f"selected={metrics['selected']} cases={metrics['cases']} "
            f"metadata_collected={metrics['metadata_collected']} "
            f"metadata_refreshed={metrics['metadata_refreshed']} "
            f"collection_ok={metrics['collection_ok']} analysis_ok={metrics['analysis_ok']}",
            flush=True,
        )
        if not args.skip_details_check:
            check_details_page(args, cases=cases, port=port)
            print("[web-direct-impala-smoke] details=ok", flush=True)
        print("[web-direct-impala-smoke] ok", flush=True)
        return 0
    except SmokeError as exc:
        print(f"[web-direct-impala-smoke] {exc}", file=sys.stderr)
        return 2
    finally:
        stop_web(process)


if __name__ == "__main__":
    raise SystemExit(main())
