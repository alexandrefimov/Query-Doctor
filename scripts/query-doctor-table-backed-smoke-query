#!/usr/bin/env python3
"""Generate a local table-backed SELECT for Known Query metadata smokes."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

ROOT_DIR = Path(__file__).resolve().parents[1]
if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

from query_doctor.impala.metadata_policy import quote_table_identifier
from query_doctor.impala.shell_runner import build_impala_shell_argv, run_impala_shell


DEFAULT_LIMIT = 100_000
DEFAULT_OUT = Path(os.environ.get("TMPDIR") or "/tmp") / "query-doctor-table-backed-smoke.sql"
IDENTIFIER_RE = re.compile(r"\A`?([A-Za-z_][A-Za-z0-9_$]*)`?\Z")
PLACEHOLDER_RE = re.compile(r"<[^>]+>")
BAD_IDENTIFIER_PARTS = {
    "db",
    "database",
    "schema",
    "table",
    "table_name",
    "tbl",
    "name",
    "unknown",
    "redacted",
    "hidden",
}
BAD_IDENTIFIER_MARKERS = ("<", ">", "[", "]", "redacted", "hidden", "unknown")


class SmokeQueryError(Exception):
    pass


@dataclass(frozen=True)
class TableCandidate:
    table: str
    mtime_ns: int
    ordinal: int


@dataclass(frozen=True)
class MetadataValidationConfig:
    coordinator: str
    impala_shell: str
    auth: str
    protocol: str | None
    kerberos_service_name: str | None
    kerberos_host_fqdn: str | None
    ssl: bool
    ca_cert: str | None
    timeout_sec: int


@dataclass(frozen=True)
class CandidateSelection:
    candidate: TableCandidate
    validation_attempts: int


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be an integer") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return parsed


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Build a read-only table-backed SELECT from existing local Query Doctor "
            "analysis.json metadata context. The script writes SQL to a local file "
            "and does not print table names."
        )
    )
    parser.add_argument(
        "--search-root",
        action="append",
        type=Path,
        help=(
            "Local ignored directory to scan for analysis.json files. May be repeated. "
            "Default: $TMPDIR or /tmp."
        ),
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=DEFAULT_OUT,
        help="Local file to write the generated SQL. Default: $TMPDIR/query-doctor-table-backed-smoke.sql.",
    )
    parser.add_argument(
        "--limit",
        type=positive_int,
        default=DEFAULT_LIMIT,
        help=f"LIMIT inside the generated sample CTE. Default: {DEFAULT_LIMIT}.",
    )
    parser.add_argument(
        "--validate-with-metadata",
        action="store_true",
        help=(
            "Before writing SQL, validate candidate tables with bounded read-only "
            "SHOW TABLE STATS through configured impala-shell metadata settings."
        ),
    )
    parser.add_argument(
        "--config",
        type=Path,
        help=(
            "Local Query Doctor config for --validate-with-metadata. Defaults to "
            "$QD_CONFIG, then ~/.qdcreds/query-doctor-config.json."
        ),
    )
    parser.add_argument(
        "--cluster",
        "--config-cluster",
        dest="cluster",
        help="Cluster id from config clusters[] for --validate-with-metadata.",
    )
    parser.add_argument(
        "--metadata-timeout-sec",
        type=positive_int,
        default=30,
        help="Timeout for each validation SHOW TABLE STATS statement. Default: %(default)s.",
    )
    return parser.parse_args(argv)


def default_search_roots() -> list[Path]:
    return [Path(os.environ.get("TMPDIR") or "/tmp")]


def analysis_paths(search_roots: list[Path]) -> list[Path]:
    paths: list[Path] = []
    for root in search_roots:
        if root.is_file() and root.name == "analysis.json":
            paths.append(root)
            continue
        if not root.is_dir():
            continue
        paths.extend(root.rglob("analysis.json"))
    return sorted(paths)


def read_json(path: Path) -> Any | None:
    try:
        return json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError):
        return None


def normalize_table_identifier(raw_table: object) -> str | None:
    table = str(raw_table or "").strip().strip("[](){}")
    if not table:
        return None
    if PLACEHOLDER_RE.search(table):
        return None
    lowered = table.lower()
    if any(marker in lowered for marker in BAD_IDENTIFIER_MARKERS):
        return None
    if any(marker in table for marker in (";", "--", "/*", "*/", "/", "\\", "@", "?", "#")):
        return None

    normalized = table.replace("`.", ".").replace(".`", ".")
    parts = [part.strip().strip("`") for part in normalized.split(".")]
    if len(parts) != 2:
        return None
    lowered_parts = [part.lower() for part in parts]
    if any(part in BAD_IDENTIFIER_PARTS for part in lowered_parts):
        return None
    if not all(IDENTIFIER_RE.fullmatch(part) for part in parts):
        return None
    return ".".join(parts)


def tables_from_analysis(payload: Any) -> list[str]:
    if not isinstance(payload, dict):
        return []
    tables: list[str] = []
    context = payload.get("table_metadata_context")
    if isinstance(context, dict):
        context_tables = context.get("tables")
        if isinstance(context_tables, list):
            for item in context_tables:
                if isinstance(item, dict):
                    table = normalize_table_identifier(item.get("table"))
                    if table is not None:
                        tables.append(table)
                else:
                    table = normalize_table_identifier(item)
                    if table is not None:
                        tables.append(table)
    references = payload.get("referenced_tables")
    if isinstance(references, list):
        for item in references:
            table = normalize_table_identifier(item)
            if table is not None:
                tables.append(table)
    return tables


def collect_candidates(paths: list[Path]) -> list[TableCandidate]:
    candidates: list[TableCandidate] = []
    ordinal = 0
    seen: set[str] = set()
    for path in paths:
        payload = read_json(path)
        try:
            mtime_ns = path.stat().st_mtime_ns
        except OSError:
            mtime_ns = 0
        for table in tables_from_analysis(payload):
            if table in seen:
                continue
            seen.add(table)
            candidates.append(TableCandidate(table=table, mtime_ns=mtime_ns, ordinal=ordinal))
            ordinal += 1
    return candidates


def sorted_candidates(candidates: list[TableCandidate]) -> list[TableCandidate]:
    return sorted(candidates, key=lambda item: (item.mtime_ns, -item.ordinal), reverse=True)


def select_candidate(candidates: list[TableCandidate]) -> CandidateSelection:
    if not candidates:
        raise SmokeQueryError(
            "No non-placeholder table-backed metadata reference was found. "
            "Run a direct Recent metadata smoke first, then retry."
        )
    return CandidateSelection(candidate=sorted_candidates(candidates)[0], validation_attempts=0)


def default_config_path() -> Path:
    if os.environ.get("QD_CONFIG"):
        return Path(os.environ["QD_CONFIG"])
    return Path.home() / ".qdcreds" / "query-doctor-config.json"


def load_config(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.expanduser().read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SmokeQueryError("Config file was not found. Set --config or QD_CONFIG.") from exc
    except json.JSONDecodeError as exc:
        raise SmokeQueryError("Config file is not valid JSON.") from exc
    if not isinstance(payload, dict):
        raise SmokeQueryError("Config root must be a JSON object.")
    return payload


def selected_config_values(config: dict[str, Any], cluster_id: str | None) -> dict[str, Any]:
    if cluster_id:
        clusters = [item for item in config.get("clusters") or [] if isinstance(item, dict)]
        for cluster in clusters:
            if str(cluster.get("id") or "") == cluster_id:
                return {**config, **cluster}
        raise SmokeQueryError("Requested cluster id was not found in config.")
    return config


def metadata_validation_config(args: argparse.Namespace) -> MetadataValidationConfig:
    config = load_config(args.config or default_config_path())
    values = selected_config_values(config, args.cluster)
    coordinator = str(values.get("metadata_coordinator") or "").strip()
    impala_shell = str(values.get("metadata_impala_shell") or "impala-shell").strip()
    if not coordinator:
        raise SmokeQueryError("Metadata validation requires metadata_coordinator in config.")
    if not impala_shell:
        raise SmokeQueryError("Metadata validation requires metadata_impala_shell in config.")
    return MetadataValidationConfig(
        coordinator=coordinator,
        impala_shell=impala_shell,
        auth=str(values.get("metadata_auth") or "kerberos").strip() or "kerberos",
        protocol=str(values.get("metadata_protocol") or "").strip() or None,
        kerberos_service_name=str(values.get("metadata_kerberos_service_name") or "").strip()
        or None,
        kerberos_host_fqdn=str(values.get("metadata_kerberos_host_fqdn") or "").strip() or None,
        ssl=bool(values.get("metadata_ssl") or False),
        ca_cert=str(values.get("metadata_ca_cert") or "").strip() or None,
        timeout_sec=args.metadata_timeout_sec,
    )


def candidate_passes_metadata_validation(
    candidate: TableCandidate,
    config: MetadataValidationConfig,
) -> bool:
    sql = "SHOW TABLE STATS " + quote_table_identifier(candidate.table)
    argv = build_impala_shell_argv(
        impala_shell=config.impala_shell,
        coordinator=config.coordinator,
        auth=config.auth,
        sql=sql,
        protocol=config.protocol,
        ssl=config.ssl,
        ca_cert=config.ca_cert,
        kerberos_service_name=config.kerberos_service_name,
        kerberos_host_fqdn=config.kerberos_host_fqdn,
    )
    completed = run_impala_shell(argv, timeout_sec=config.timeout_sec)
    return completed.returncode == 0


def select_validated_candidate(
    candidates: list[TableCandidate],
    config: MetadataValidationConfig,
) -> CandidateSelection:
    attempts = 0
    for candidate in sorted_candidates(candidates):
        attempts += 1
        try:
            if candidate_passes_metadata_validation(candidate, config):
                return CandidateSelection(candidate=candidate, validation_attempts=attempts)
        except Exception:
            continue
    raise SmokeQueryError(
        "No candidate table passed metadata validation. "
        "Rerun a direct Recent metadata smoke or widen the search root."
    )


def quote_identifier(value: str) -> str:
    return "`" + value.replace("`", "``") + "`"


def quote_table(table: str) -> str:
    return ".".join(quote_identifier(part) for part in table.split("."))


def build_query(table: str, *, limit: int) -> str:
    return (
        "WITH sample_rows AS (\n"
        "  SELECT *\n"
        f"  FROM {quote_table(table)}\n"
        f"  LIMIT {limit}\n"
        ")\n"
        "SELECT\n"
        "  COUNT(*) AS rows_seen,\n"
        "  SUM(CAST(rand() * 1000000 AS BIGINT)) AS runtime_guard\n"
        "FROM sample_rows;\n"
    )


def write_query(path: Path, sql: str) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(sql, encoding="utf-8")
    except OSError as exc:
        raise SmokeQueryError("Could not write the generated SQL file.") from exc


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    search_roots = args.search_root or default_search_roots()
    paths = analysis_paths(search_roots)
    candidates = collect_candidates(paths)
    try:
        if args.validate_with_metadata:
            selection = select_validated_candidate(candidates, metadata_validation_config(args))
        else:
            selection = select_candidate(candidates)
        write_query(args.out, build_query(selection.candidate.table, limit=args.limit))
    except SmokeQueryError as exc:
        print(f"[table-backed-smoke-query] {exc}", file=sys.stderr)
        return 2

    print("[table-backed-smoke-query] generated=ok")
    print(f"[table-backed-smoke-query] analysis_files_scanned={len(paths)}")
    print(f"[table-backed-smoke-query] candidate_tables={len(candidates)}")
    print(
        "[table-backed-smoke-query] metadata_validation="
        + ("enabled" if args.validate_with_metadata else "disabled")
    )
    print(
        f"[table-backed-smoke-query] metadata_validation_attempts={selection.validation_attempts}"
    )
    print(f"[table-backed-smoke-query] limit={args.limit}")
    print("[table-backed-smoke-query] output=written")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
