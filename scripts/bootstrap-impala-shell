#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="${QD_IMPALA_SHELL_VENV:-$ROOT_DIR/.venv-impala-shell}"
REQUIREMENTS="${QD_IMPALA_SHELL_REQUIREMENTS:-$ROOT_DIR/requirements-impala-shell.txt}"
IMPALA_SHELL_VERSION="${QD_IMPALA_SHELL_VERSION:-4.3.0}"

if [[ ! -r "$REQUIREMENTS" ]]; then
  echo "Missing impala-shell requirements file: $REQUIREMENTS" >&2
  exit 2
fi

if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  python3 -m venv "$VENV_DIR"
fi

"$VENV_DIR/bin/python" -m pip install -r "$REQUIREMENTS"
"$VENV_DIR/bin/python" -m pip install --no-deps "impala_shell==$IMPALA_SHELL_VERSION"
# Upstream impala_shell 4.3.0 is the newest PyPI release and still declares
# vulnerable sqlparse==0.3.1. Keep the isolated CLI on patched runtime pins and
# make installed metadata match so pip check and scanners do not see a stale pin.
"$VENV_DIR/bin/python" - "$REQUIREMENTS" <<'PY'
import sys
from importlib.metadata import distribution
from pathlib import Path

requirements_path = Path(sys.argv[1])
sqlparse_pin = None
for raw_line in requirements_path.read_text(encoding="utf-8").splitlines():
    line = raw_line.partition("#")[0].strip()
    if line.lower().startswith("sqlparse=="):
        sqlparse_pin = line.split("==", 1)[1]
        break

if not sqlparse_pin:
    raise SystemExit(f"Missing sqlparse pin in {requirements_path}")

dist_info = Path(distribution("impala-shell")._path)
metadata_path = dist_info / "METADATA"
if not metadata_path.is_file():
    metadata_path = dist_info / "PKG-INFO"
metadata = metadata_path.read_text(encoding="utf-8")
legacy_requirement = "Requires-Dist: sqlparse==0.3.1"
patched_requirement = f"Requires-Dist: sqlparse=={sqlparse_pin}"
if legacy_requirement in metadata:
    metadata_path.write_text(
        metadata.replace(legacy_requirement, patched_requirement),
        encoding="utf-8",
    )
elif patched_requirement not in metadata:
    raise SystemExit(
        "Unexpected impala_shell sqlparse requirement in "
        f"{metadata_path}; update bootstrap compatibility handling"
    )
PY

if [[ ! -x "$VENV_DIR/bin/impala-shell" ]]; then
  echo "impala-shell was not installed into $VENV_DIR" >&2
  exit 2
fi

echo "$VENV_DIR/bin/impala-shell"
