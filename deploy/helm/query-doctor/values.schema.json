{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["publicDemo", "configured"]
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingConfigMap": { "type": "string" },
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "inlineJson": { "type": "string" }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "recentHistory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "dsnKey": { "type": "string" },
            "dsnEnvName": { "type": "string" },
            "readiness": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "resources": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "retention": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "schedule": { "type": "string", "minLength": 1 },
                "suspend": { "type": "boolean" },
                "concurrencyPolicy": {
                  "type": "string",
                  "enum": ["Allow", "Forbid", "Replace"]
                },
                "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
                "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
                "backoffLimit": { "type": "integer", "minimum": 0 },
                "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
                "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
                "summaryRetentionDays": { "type": ["integer", "null"], "minimum": 1 },
                "profileJobRetentionDays": { "type": ["integer", "null"], "minimum": 1 },
                "analysisCacheRetentionDays": { "type": ["integer", "null"], "minimum": 1 },
                "profileArtifactRetentionDays": {
                  "type": ["integer", "null"],
                  "minimum": 1
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "podAnnotations": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "profileRemediation": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "schedule": { "type": "string", "minLength": 1 },
                "suspend": { "type": "boolean" },
                "concurrencyPolicy": {
                  "type": "string",
                  "enum": ["Allow", "Forbid", "Replace"]
                },
                "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
                "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
                "backoffLimit": { "type": "integer", "minimum": 0 },
                "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
                "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
                "maxJobs": { "type": "integer", "minimum": 1 },
                "engine": { "type": "string" },
                "sourceKind": { "type": "string" },
                "sourceKey": { "type": "string" },
                "annotations": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "podAnnotations": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "cnpg": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "instances": { "type": "integer", "minimum": 1 },
                "database": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "existingOwnerSecret": { "type": "string" },
                "imageName": { "type": "string" },
                "storage": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "size": { "type": "string", "minLength": 1 }
                  }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operatorReadiness": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string", "minLength": 1 },
            "suspend": { "type": "boolean" },
            "concurrencyPolicy": {
              "type": "string",
              "enum": ["Allow", "Forbid", "Replace"]
            },
            "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
            "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
            "summaryDir": { "type": "string", "minLength": 1 },
            "postgresReadinessSummaryJson": { "type": "string", "minLength": 1 },
            "profileWorkerSummaryJson": { "type": "string", "minLength": 1 },
            "collectorSummaryJson": { "type": "string" },
            "retentionSummaryJson": { "type": "string" },
            "profileRemediationSummaryJson": { "type": "string" },
            "outputSummaryJson": { "type": "string", "minLength": 1 },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "resources": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "recentSummaryCollector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Allow", "Forbid", "Replace"]
        },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "out": { "type": "string", "minLength": 1 },
        "summaryJson": { "type": "string", "minLength": 1 },
        "progressJsonl": { "type": "string", "minLength": 1 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "recentProfileWorker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Allow", "Forbid", "Replace"]
        },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "maxJobs": { "type": "integer", "minimum": 1 },
        "leaseSeconds": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "leaseOwner": { "type": "string", "minLength": 1 },
        "out": { "type": "string", "minLength": 1 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "kerberos": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "principalKey": { "type": "string" },
        "keytabKey": { "type": "string" },
        "krb5ConfKey": { "type": "string" },
        "cachePath": { "type": "string", "minLength": 1 },
        "renewer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "refreshIntervalSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "resources": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "size": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 },
        "recentBatchMountPath": { "type": "string", "minLength": 1 }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "allowNonlocalWebBind": { "type": "boolean" },
        "noLlm": { "type": "boolean" },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selfTestJob": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "egressMode": {
          "type": "string",
          "enum": ["denyAll", "allowAll", "custom"]
        },
        "egress": { "type": "array" }
      }
    }
  }
}
